{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=SkillBridge;Username=postgres;Password=YOUR_DB_PASSWORD;Port=5432"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_YOUR_SECRET_MIN_32_CHARS",
    "Issuer": "SkillBridge.Api",
    "Audience": "SkillBridge.Clients",
    "ExpiryMinutes": 1440
  },
  "AgenticAiService": {
    "BaseUrl": "http://localhost:8000"
  }
}
